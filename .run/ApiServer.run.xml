<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="ApiServer" type="SpringBootApplicationConfigurationType" factoryName="Spring Boot">
    <option name="FRAME_DEACTIVATION_UPDATE_POLICY" value="UpdateClassesAndResources" />
    <module name="api-server.main" />
    <option name="SPRING_BOOT_MAIN_CLASS" value="com.inbeom.apiserver.ApiServerApplication" />
    <method v="2">
      <option name="Make" enabled="true" />
      <!--
        실행 직전에 7070 을 비운다. 이 구성은 main 클래스를 직접 띄우므로 bootRun 을 거치지 않아,
        build.gradle 의 bootRun.dependsOn('freePort') 가 적용되지 않는다. 그래서 여기서 따로 건다.
        (freePort → api-server/free-port.sh — 무엇을 죽였는지 출력하고, Docker 가 포트를 쓰고 있으면
        죽이지 않고 실패시킨다.)
      -->
      <option name="Gradle.BeforeRunTask" enabled="true" tasks="freePort" externalProjectPath="$PROJECT_DIR$/api-server" vmOptions="" scriptParameters="" />
    </method>
  </configuration>
</component>